{
  "sdd-session-index": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/session-start.mjs",
        "timeout": 5
      }
    ]
  },
  "sdd-post-edit-gate": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/post-edit-check.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "sdd-stop-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "./scripts/stop-verify.sh",
        "timeout": 5
      }
    ]
  }
}
